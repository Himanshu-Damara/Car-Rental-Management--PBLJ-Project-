<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#17191d">
  <meta name="app-context" content="${pageContext.request.contextPath}">
  <title>CU Drive | Chandigarh Car Rental</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="${pageContext.request.contextPath}/assets/css/site.css?v=20261103-2" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg site-navbar">
    <div class="container">
      <a class="navbar-brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">C</span> CU <b>DRIVE</b></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="mainNav">
        <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          <a class="nav-link" href="${pageContext.request.contextPath}/cars">Explore cars</a>
          <c:if test="${not empty sessionScope.user}">
            <a class="nav-link" href="${pageContext.request.contextPath}/bookings">My bookings</a>
            <c:if test="${sessionScope.user.role eq 'ADMIN'}"><a class="nav-link" href="${pageContext.request.contextPath}/admin/dashboard">Admin</a></c:if>
            <form method="post" action="${pageContext.request.contextPath}/logout" class="nav-logout">
              <input type="hidden" name="_csrf" value="${csrf}">
              <button class="btn btn-sm btn-outline-dark" type="submit">Sign out</button>
            </form>
          </c:if>
          <c:if test="${empty sessionScope.user}">
            <a class="nav-link" href="${pageContext.request.contextPath}/login">Sign in</a>
            <a class="btn btn-sm btn-accent nav-join" href="${pageContext.request.contextPath}/register">Create account</a>
          </c:if>
        </div>
      </div>
    </div>
  </nav>
  <main>
